#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir> <env-dir>

set -euo pipefail

function indent() {
  c='s/^/       /'
  case $(uname) in
    Darwin) sed -l "$c";;
    *)      sed -u "$c";;
  esac
}

ENV_DIR=$3
AWS_CLI_VERSION_FILE="$ENV_DIR/AWS_CLI_VERSION"
if [ -f "$AWS_CLI_VERSION_FILE" ]; then
  AWS_CLI_VERSION=$(cat $AWS_CLI_VERSION_FILE)
else
  AWS_CLI_VERSION=""
fi

if [ -n "$AWS_CLI_VERSION" ]; then
  AWS_CLI_URL="https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${AWS_CLI_VERSION}.zip"
else
  AWS_CLI_URL="https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip"
fi

BUILD_DIR=$1
BUILDPACK_DIR="$(dirname $(dirname $0))"
TMP_DIR=$(mktemp -d)
# Infer INSTALL_DIR based on BUILD_DIR indicators
case "$BUILD_DIR" in
  /app|/workspace|/home/heroku) INSTALL_DIR="$BUILD_DIR/.awscli";;
  *)
    INSTALL_DIR="/app/.awscli"
    mkdir -p "$INSTALL_DIR"
    ;;
esac

echo "-----> Downloading AWS CLI"
curl --silent --show-error --fail -o "${TMP_DIR}/awscliv2.zip" "${AWS_CLI_URL}" |& indent
unzip -qq -d "${TMP_DIR}" "${TMP_DIR}/awscliv2.zip" |& indent

echo "-----> Installing AWS CLI"
"${TMP_DIR}/aws/install" --install-dir "${INSTALL_DIR}/aws-cli" --bin-dir "${INSTALL_DIR}/bin" |& indent
"${INSTALL_DIR}/bin/aws" --version |& indent

# Copy over if build dir is separate from install.
[[ "${INSTALL_DIR}" != "${BUILD_DIR}/.awscli" ]] && cp -a "${INSTALL_DIR}" "${BUILD_DIR}/.awscli"

mkdir -p "${BUILD_DIR}/.profile.d"
cat > "${BUILD_DIR}/.profile.d/awscli.sh" <<'PROFILE'
export PATH="$PWD/.awscli/bin:${PATH}"
PROFILE

if [[ -w "${BUILDPACK_DIR}" ]]; then
  cat > "${BUILDPACK_DIR}/export" <<'EXPORT'
export PATH="$PWD/.awscli/bin:${PATH}"
EXPORT
fi

rm -rf "${TMP_DIR}"

echo "-----> Successfully installed AWS CLI"
